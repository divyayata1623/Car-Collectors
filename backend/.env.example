# Database Configuration
DATABASE_URL=postgresql://<database-user>:<database-password>@localhost:5432/car_collectors
DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_collectors
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Authentication
SECRET_KEY=replace_with_a_unique_random_secret_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=car-collectors-product-images
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Application Settings
ENVIRONMENT=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
API_PORT=8000
API_HOST=0.0.0.0

# CORS Settings
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Admin User (Initial Setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_FULL_NAME=Store Administrator

# Image Upload Settings
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
